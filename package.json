{
  "name": "panel-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "lint": "ng lint",
    "unit": "ng test --watch=false",
    "coverage": "ng test --watch=false --coverage --coverage-reporters=lcov --coverage-reporters=json-summary --coverage-reporters=text-summary",
    "coverage:check": "node scripts/check-coverage.mjs",
    "verify": "npm run lint && npm run coverage && npm run coverage:check && npm run build",
    "test": "npm run unit && npm run lint && npm run build"
  },
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "lucide-angular": "1.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.30",
    "@angular/cli": "21.2.30",
    "@angular/compiler-cli": "21.2.26",
    "@cyclonedx/cyclonedx-npm": "7.0.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@vitest/coverage-v8": "4.1.12",
    "angular-eslint": "21.4.0",
    "eslint": "10.15.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  }
}
